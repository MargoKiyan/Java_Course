<plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version><configuration><mainClass>CoroutineBasicKt</mainClass><executable>${java.home}/bin/java</executable><arguments><argument>-classpath</argument><classpath/><argument>CoroutineBasicKt</argument></arguments></configuration></plugin>
